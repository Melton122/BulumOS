#!/bin/sh
# BulumOS udhcpc helper: configure the interface from DHCP options.
# Uses the CIDR prefix provided by udhcpc (no hardcoded /24).
case "$1" in
  deconfig)
    ip addr flush dev "$interface" 2>/dev/null
    ;;
  bound|renew)
    ip addr add "$ip/${subnet:-24}" broadcast "$broadcast" dev "$interface"
    ip link set "$interface" up 2>/dev/null
    [ -n "$router" ] && route add default gw "$router" 2>/dev/null
    echo -n > /etc/resolv.conf
    for ns in $dns; do
      echo "nameserver $ns" >> /etc/resolv.conf
    done
    [ -n "$domain" ] && echo "search $domain" >> /etc/resolv.conf
    ;;
esac